# Démo GoBox : site statique, aucun script serveur
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .js
  AddType image/svg+xml .svg
  # gobox.wasm.gz est décompressé par la page : jamais d'en-tête Content-Encoding
  RemoveEncoding .gz
  AddType application/octet-stream .gz
</IfModule>

# Compression des fichiers texte (le .wasm.gz l'est déjà)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/wasm image/svg+xml application/xml text/plain
  SetEnvIfNoCase Request_URI "\.gz$" no-gzip dont-vary
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(gz|js|css|svg|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
