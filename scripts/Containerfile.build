# Compilation de gobox sur une glibc ancienne (2.28) : le binaire tourne ensuite
# sur toute distribution plus récente. Go vient de la machine (scripts/build-portable.sh).
FROM docker.io/library/almalinux:8
RUN dnf install -y dnf-plugins-core \
 && dnf config-manager --set-enabled powertools \
 && dnf install -y gcc binutils pkgconfig rpm-build libX11-devel libXcursor-devel libXrandr-devel \
      libXinerama-devel libXi-devel libXxf86vm-devel mesa-libGL-devel \
 && dnf clean all
